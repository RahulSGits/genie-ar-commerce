# ─────────────────────────────────────────────────────────────────────────────
# GENIE — environment variables
#
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle — treat it as
# public. Everything else is server-only and must never be imported into a
# Client Component.
#
# NOTHING BELOW IS REQUIRED TO RUN THE PROJECT. The database is node:sqlite,
# built into Node — `npm install && npm run db:models && npm run db:seed` is all
# it takes. Every variable here either points the app at a public URL or turns
# on an optional integration.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin, used to build QR target URLs and absolute model URLs for
# Android Scene Viewer. Must be https:// in production — AR requires a secure
# context.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Super Admin bootstrap ────────────────────────────────────────────────────
# Used ONLY by `npm run db:seed` to create the first platform owner account.
# Set these locally; in production set them in your host's env panel and rotate
# the password after first login. Never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL PAID INTEGRATIONS — all disabled by default.
# The MVP runs fully without every variable below. Each is gated behind a
# feature flag in the `system_settings` table; leaving these blank keeps the
# corresponding feature switched off rather than broken.
# ─────────────────────────────────────────────────────────────────────────────

# ── Email (OPTIONAL) ─────────────────────────────────────────────────────────
# Without these, notifications are still recorded in-app and written to
# notification_logs with status 'skipped_no_provider'. Any SMTP host works,
# including free tiers.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GENIE

# ── Payment gateway (OPTIONAL PAID INTEGRATION) ──────────────────────────────
# Billing is manual-first: invoices and payments are recorded by the super admin
# with no gateway at all. These only enable self-serve online payment later.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp / SMS (OPTIONAL PAID INTEGRATION) ───────────────────────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Voice AI calling (OPTIONAL PAID INTEGRATION) ─────────────────────────────
# Disabled by default. Never enable without an explicit spend limit — outbound
# calls bill per minute.
VOICE_PROVIDER=
VOICE_API_KEY=
VOICE_API_SECRET=
VOICE_FROM_NUMBER=

# ── AI 3D model generation ───────────────────────────────────────────────────
# Which provider turns product photos into a GLB. Registered in
# lib/ai3d/provider.ts. Both this AND the `model_generation` feature flag in
# /admin/settings must be on before generation is offered.
#
#   (blank)      No generation. The UI removes the option and points users at
#                uploading a GLB they already have.
#   development  Walks the real pipeline with no key and no spend, then attaches
#                a demo GLB. Every result is stamped "development placeholder —
#                not AI generated" in the model name and the UI, so it can never
#                be mistaken for real output. Use this to exercise the flow.
#   meshy        Real image-to-3D. OPTIONAL PAID INTEGRATION — needs a key and
#                bills per generation.
MODEL_GEN_PROVIDER=development

# Required for `meshy`. Never for `development`.
MODEL_GEN_API_KEY=

# Override the provider's API base (self-hosted or a staging endpoint).
MODEL_GEN_API_URL=

# Set to 1 to log raw provider requests/responses — the fastest way to diagnose
# an API shape mismatch on a first real run.
MODEL_GEN_DEBUG=

# ── Billing automation ───────────────────────────────────────────────────────
# Bearer token for POST/GET /api/cron/billing, which raises renewal invoices,
# marks invoices overdue, advances subscription lifecycle and sends reminders.
# WITHOUT THIS SET THE ENDPOINT REFUSES EVERY REQUEST — it never defaults to
# open. Billing still stays current without a scheduler: the same tick runs
# opportunistically (rate-limited) when an admin loads the dashboard.
CRON_SECRET=

# ── Error monitoring (OPTIONAL) ──────────────────────────────────────────────
# Logging goes to stdout by default via a provider abstraction.
SENTRY_DSN=
