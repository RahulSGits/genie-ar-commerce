# ─────────────────────────────────────────────────────────────────────────────
# ARView Commerce — environment variables
#
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle — treat it as
# public. Everything else is server-only and must never be imported into a
# Client Component.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Create a free project at https://supabase.com/dashboard, then copy these from
# Project Settings → API.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" key. Safe in the browser — Row Level Security is what protects
# your data, not this key's secrecy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. BYPASSES ALL ROW LEVEL SECURITY.
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
# Used only by: admin server actions, the seed script, and storage cleanup jobs.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin, used to build QR target URLs and absolute model URLs for
# Android Scene Viewer. Must be https:// in production — AR requires a secure
# context.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Super Admin bootstrap ────────────────────────────────────────────────────
# Used ONLY by `npm run db:seed` to create the first platform owner account.
# Set these locally; in production set them in your host's env panel and rotate
# the password after first login. Never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL PAID INTEGRATIONS — all disabled by default.
# The MVP runs fully without every variable below. Each is gated behind a
# feature flag in the `system_settings` table; leaving these blank keeps the
# corresponding feature switched off rather than broken.
# ─────────────────────────────────────────────────────────────────────────────

# ── Email (OPTIONAL) ─────────────────────────────────────────────────────────
# Without these, notifications are still recorded in-app and written to
# notification_logs with status 'skipped_no_provider'. Any SMTP host works,
# including free tiers.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ARView Commerce

# ── Payment gateway (OPTIONAL PAID INTEGRATION) ──────────────────────────────
# Billing is manual-first: invoices and payments are recorded by the super admin
# with no gateway at all. These only enable self-serve online payment later.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp / SMS (OPTIONAL PAID INTEGRATION) ───────────────────────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Voice AI calling (OPTIONAL PAID INTEGRATION) ─────────────────────────────
# Disabled by default. Never enable without an explicit spend limit — outbound
# calls bill per minute.
VOICE_PROVIDER=
VOICE_API_KEY=
VOICE_API_SECRET=
VOICE_FROM_NUMBER=

# ── AI 3D model generation (OPTIONAL PAID INTEGRATION) ───────────────────────
# The MVP does not generate 3D models. Businesses upload their own GLB/USDZ.
# A provider interface exists so this can be added without rewriting anything.
MODEL_GEN_PROVIDER=
MODEL_GEN_API_KEY=

# ── Error monitoring (OPTIONAL) ──────────────────────────────────────────────
# Logging goes to stdout by default via a provider abstraction.
SENTRY_DSN=
