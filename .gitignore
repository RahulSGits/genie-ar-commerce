# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# secrets — never commit
.env
.env.local
.env*.local
.env.production

# TLS certs generated for local https dev
certificates/

# supabase local
supabase/.temp/
supabase/.branches/

# testing
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# local SQLite database — regenerate with `npm run db:seed`
data/

# uploads written during local dev
public/uploads/

# Generated demo assets — both come out of `npm run db:models`, so neither is
# tracked. Keeping the posters but not the models would be the worst of both:
# a clone that looks like it has assets but cannot render anything.
public/models/
public/posters/

# os / editor
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel
# Every build directory, not just the ones that existed when this was written.
# `NEXT_DIST_DIR` is used to build into a throwaway directory while the dev
# server keeps its own — and a one-off name like `.next-check` slipped past the
# explicit list and committed 350 MB of webpack cache.
.next*/

# Generated by `npm run db:seed` — contains live credentials.
.seed-credentials.json
